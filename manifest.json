{
  "manifest_version": 3,
  "name": "MarsWork",
  "description": "Personal productivity dashboard for focus, todos, clock, calendar, weather, quotes, and favorites.",
  "version": "1.0.0",

  "chrome_url_overrides": {
    "newtab": "index.html"
  },

  "icons": {
    "16": "assets/icons/icon-16.png"
  },

  "permissions": ["storage", "notifications", "alarms"],

  "host_permissions": ["https://api.openweathermap.org/*"],

  "action": {
    "default_title": "MarsWork"
  }
}
